# 可选：第三方 YouTube 字幕 API（youtube-transcript.io）
# 填了 → YouTube 有官方字幕时 1 秒出结果；留空 → 下载 + 本地转录，照样能用
YOUTUBE_TRANSCRIPT_API_URL=https://www.youtube-transcript.io/api/transcripts
YOUTUBE_TRANSCRIPT_API_TOKEN=

# 数据目录（模型 / 输出 / 缓存），默认 ~/.video-subtitle-extractor
# VSX_HOME=/path/to/.video-subtitle-extractor

# 代理：只作用于 YouTube 下载与模型下载，国内站点默认不走
# YTSUB_PROXY=http://127.0.0.1:7890

# Whisper 默认参数
YTSUB_WHISPER_MODEL=small
YTSUB_WHISPER_DEVICE=auto

# 模型下载源（默认 hf-mirror，海外可改成 https://huggingface.co）
# VSX_HF_ENDPOINT=https://hf-mirror.com
